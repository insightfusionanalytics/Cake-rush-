# Supabase configuration — copy this file to `.env` and fill in real values.
# Find these in Supabase Dashboard → Project Settings → API.
# All three are exposed to the browser (Vite inlines VITE_* vars at build),
# so use the *publishable* (anon) key — never the service-role secret.

VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
